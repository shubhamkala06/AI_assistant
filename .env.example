# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------

APP_NAME=AI Assistant
ENVIRONMENT=development
DEBUG=true
AUTH_RESET_PASSWORD_TOKEN_SECRET=
AUTH_VERIFICATION_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_LIFETIME_SECONDS=
AUTH_COOKIE_NAME=
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=

# ---------------------------------------------------------------------
# OAuth/OIDC
# ---------------------------------------------------------------------

AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_OAUTH_STATE_SECRET=

# ---------------------------------------------------------------------
# AI Models
# ---------------------------------------------------------------------

AI_OPENAI_API_KEY=
AI_OPENAI_EMBEDDING_MODEL=
AI_OPENAI_CHAT_MODEL=

AI_GOOGLE_API_KEY=
AI_GEMINI_CHAT_MODEL=
AI_GEMINI_EMBEDDING_MODEL=

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------

LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

DATABASE_ECHO=false